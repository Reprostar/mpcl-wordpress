#. translators: %d: MyPCList machine ID used in the shortcode.
#: templates/box.php:42
#, php-format
msgid "MyPCList: machine #%d is not in the synced collection. If it exists in your collection, it will appear after the next sync. Only editors see this message."
msgstr "MyPCList: maszyna #%d nie znajduje się w zsynchronizowanej kolekcji. Jeśli istnieje w Twojej kolekcji, pojawi się po następnej synchronizacji. Ten komunikat widzą tylko redaktorzy."

#: templates/single.php:9
msgid "&laquo; Back to the list"
msgstr "&laquo; Powrót do listy"

