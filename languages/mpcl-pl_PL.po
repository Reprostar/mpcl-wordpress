msgstr "Nazwa własna"

#: templates/single.php:37
msgid "Physical state"
msgstr "Stan fizyczny"

#: templates/single.php:64
msgid "Requested machine cannot be found. Check if you entered a valid URL."
msgstr "Żądana maszyna nie została odnaleziona. Upewnij się, czy podany adres URL jest poprawny."
