<?xml version="1.0"?>
<ruleset name="mpcl">
    <description>PHP 7.4+ compatibility for the shipped plugin.</description>

    <file>mpcl.php</file>
    <file>src</file>
    <file>templates</file>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_supported_wp_version" value="6.9"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
